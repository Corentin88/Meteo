# Exemple de configuration d'environnement pour dev/test
# Ce fichier sert de modèle pour votre .env ou .env.local
# Ne commitez pas de secrets réels dans le dépôt.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=ChangeMe_1234567890abcdef
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# IMPORTANT: définissez la version de votre serveur dans l'URL (serverVersion)
# Option SQLite (simple pour tests) :
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
#DATABASE_URL="mysql://Nom:ChangeMe@127.0.0.1:3306/Meteo?serverVersion=10.0.0&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> RapidAPI (Meteosource) ###
# Clé RapidAPI (remplacez la valeur par votre clé)
RAPIDAPI_KEY=your-rapidapi-key
###< RapidAPI (Meteosource) ###

###> Nominatim (OpenStreetMap) ###
# User-Agent requis par la politique Nominatim :
# Format recommandé : AppName/Version (contact@email)
USERAGENT="YourAppName/1.0 (contact@example.com)"
###< Nominatim (OpenStreetMap) ###