{# 
    FICHIER : index.html.twig
    ========================
    Template principal de l'application météo qui affiche :
    - Les conditions météorologiques actuelles
    - Les prévisions sur 7 jours
    - Un formulaire de recherche par ville

    SÉCURITÉ :
    - Utilisation systématique des filtres d'échappement Twig (e()) pour prévenir les attaques XSS
    - Échappement des URLs et attributs HTML
    - Validation des entrées utilisateur côté serveur

    VARIABLES DISPONIBLES :
    - ville : Nom de la ville recherchée
    - day : Date du jour formatée
    - weather/icon : Conditions météo actuelles et icône correspondante
    - temperature/feelsLike : Température actuelle et ressentie
    - dailyData : Tableau des prévisions sur 7 jours
#}

{# Héritage du template de base #}
{% extends 'base.html.twig' %}

{# Titre de la page #}
{% block title %}Météo du jour - {{ ville|e('html') }}{% endblock %}

{# Contenu principal de la page #}
{% block body %}
    {# Affichage des messages flash d'erreur #}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger auto-dismiss">
            {{ message }}
        </div>
    {% endfor %}

    {# Section de recherche de ville #}
    <div class="container mt-2">
        <div class="col-md-6 col-lg-6">
            {# 
                Formulaire de recherche
                - Méthode GET pour permettre le partage d'URL
                - Champ requis pour éviter les recherches vides
            #}
            <form action="{{ path('meteo') }}" method="GET">         
                <input type="text" 
                       name="ville" 
                       placeholder="Entrez une ville" 
                       value="{{ ville }}" 
                       required
                       aria-label="Rechercher une ville">
                <button type="submit">Rechercher</button>  
            </form>
        </div>
    </div>

    {# En-tête de la section météo du jour #}
    <div class="containerTitle">
        <h1>Météo du jour pour {{ ville|e('html')|capitalize }}</h1>
    </div>
    
    {# Carte météo du jour #}
    <div class="weather-today">
        <div class="weather-cardToday">
            <h2 aria-level="2">{{ day|e('html') }}</h2>
            
            {# 
                Affichage de l'icône météo
                - Chemin dynamique vers les icônes météo
                - Alternative textuelle pour l'accessibilité
            #}
            <img class="icon" 
                 src="{{ asset('assets/icons/weather_icons/set01/big/' ~ icon|e('url') ~ '.png') }}" 
                 alt="{{ weather|e('html_attr') }}"
                 aria-hidden="true">
            
            {# Données météo principales #}
            <p>Résumé : <span class="value">{{ summary|e('html') }}</span></p>
            <p class="temperature">
                Température : 
                <span class="value colorTemp">{{ temperature|e('html') }}°C</span>
            </p>
            
            {# Détails météorologiques #}
            <div class="weather-data">
                <p>Température min : <span class="value colorTemp">{{ temperatureMin|e('html') }}°C</span></p>
                <p>Température max : <span class="value colorTemp">{{ temperatureMax|e('html') }}°C</span></p>
                <p>Ressenti : <span class="value colorTemp">{{ feelsLike|e('html') }}°C</span></p>
                <p>Vent : <span class="value">{{ windSpeed|e('html') }} km/h</span></p>
                <p>Précipitations : <span class="value">{{ precipitationType|e('html') }} ({{ probabilityPrecipitation|e('html') }}%)</span></p>
                <p>Risque orage : <span class="value">{{ probabilityStorm|e('html') }}%</span></p>
                <p>Risque gel : <span class="value">{{ probabilityFreeze|e('html') }}%</span></p>
                <p>Humidité : <span class="value">{{ humidity|e('html') }}%</span></p>
            </div>
        </div>
    </div>
    
    {# Section des prévisions sur 7 jours #}
    <div class="containerTitle">
        <h2>Prévisions pour la semaine</h2>
    </div>
    
    <div class="weather-week">
        {% for forecast in dailyData %}
            {# 
                Carte pour chaque jour de prévision
                Utilisation de la variable 'forecast' au lieu de 'day' pour plus de clarté
            #}
            <div class="weather-cardWeek">
                <h3>{{ forecast.formattedDay|e('html') }}</h3>
                
                <img class="icon" 
                     src="{{ asset('assets/icons/weather_icons/set01/big/' ~ forecast.icon|e('url') ~ '.png') }}" 
                     alt="{{ forecast.weather|default(weather)|e('html_attr') }}"
                     aria-hidden="true">
                
                {# Données météo pour le jour #}
                <p>Température : <span class="value colorTemp">{{ forecast.temperature|e('html') }}°C</span></p>
                <p>Min/Max : 
                    <span class="value colorTemp">
                        {{ forecast.temperature_min|e('html') }}°C / {{ forecast.temperature_max|e('html') }}°C
                    </span>
                </p>
                <p>Ressenti : <span class="value colorTemp">{{ forecast.feels_like|e('html') }}°C</span></p>
                <p>Vent : <span class="value">{{ forecast.wind.speed|e('html') }} km/h</span></p>
                <p>Précipitations : 
                    <span class="value">
                        {{ forecast.precipitation.type|e('html') }} ({{ forecast.probability.precipitation|e('html') }}%)
                    </span>
                </p>
            </div>
        {% endfor %}
    </div>
{% endblock %}

{# 
    Section JavaScript
    ==================
    - Inclut le template parent
    - Charge le fichier JavaScript spécifique à la météo
#}
{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/meteo.js') }}" defer></script>
{% endblock %}